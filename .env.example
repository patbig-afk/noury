# Base Postgres (Neon via le Marketplace Vercel : les 2 variables sont créées automatiquement)
DATABASE_URL="postgresql://user:password@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/db?sslmode=require"

# Store Vercel Blob (créé en mode PRIVÉ)
BLOB_READ_WRITE_TOKEN=""

# Accès à l'app
APP_PASSWORD="choisis-un-mot-de-passe"
AUTH_SECRET="chaine-aleatoire-longue"   # ex : openssl rand -hex 32
