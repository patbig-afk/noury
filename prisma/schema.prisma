// Schéma de la base "Suivi dépenses maison Noury"
// Docs : https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Payer {
  PATRICK
  CHARLOTTE
  BOTH
}

// SHARED : achat, travaux, amélioration → partagé 70/30 (engagements, vente).
// CURRENT : dépense courante → à la charge de qui l'a payée (séparation de biens, pas de partage des frais courants).
enum ExpenseKind {
  SHARED
  CURRENT
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  expenses  Expense[]
}

model Expense {
  id          String      @id @default(cuid())
  date        DateTime    @db.Date
  categoryId  String
  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  description String
  supplier    String
  amount      Decimal     @db.Decimal(12, 2)
  paidBy      Payer
  kind        ExpenseKind @default(SHARED)

  // Valeurs calculées à l'enregistrement (cf. src/lib/split.ts)
  sharePatrick    Decimal @db.Decimal(12, 2)
  shareCharlotte  Decimal @db.Decimal(12, 2)
  paidPatrick     Decimal @db.Decimal(12, 2)
  paidCharlotte   Decimal @db.Decimal(12, 2)
  owedByCharlotte Decimal @db.Decimal(12, 2) // > 0 : Charlotte doit à Patrick ; < 0 : l'inverse

  // Fichiers : pathname dans le store Vercel Blob privé, ou lien externe (https://…, ex. Google Drive
  // pour l'historique importé du Sheet).
  invoicePath String?
  invoiceName String?
  proofPath   String?
  proofName   String?
  proof2Path  String?
  proof2Name  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([date])
  @@index([categoryId])
}
